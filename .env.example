# Copy this file to ".env" at the repo root and edit the paths.
# The server reads these on startup. os.environ wins over .env values.

# Required: absolute path to the single .pptx the server is bound to.
# It does NOT have to exist yet — call create_presentation_from_template
# to materialise it from PPTX_TEMPLATE.
PPTX_TARGET=/abs/path/to/your/deck.pptx

# Optional: absolute path to a .pptx or .potx template.
# Use examples/template.pptx after running examples/build_template.py.
PPTX_TEMPLATE=/abs/path/to/your/template.pptx
